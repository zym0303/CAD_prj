# Python environment and caches (each person builds their own with setup_mac.sh)
.venv/
__pycache__/
*.pyc

# Simulation output - regenerated on every run, can be thousands of files
no_backup/

# Editor / OS clutter
.DS_Store
.vscode/
*.bak

# Training output: plots, logs, history.csv, summary.json are tracked;
# the saved network weights (~3 MB per run) are not
output_figs/**/td3_*
data/
